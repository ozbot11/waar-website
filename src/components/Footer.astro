---
const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="foot-inner">
    <div class="col brandcol">
      <div class="fbrand"><span class="mark">▲</span> Washington Aerial Robotics</div>
      <p class="tagline">Autonomous UAVs, built by students at the University of Washington.</p>
      <a class="email mono" href="mailto:washingtonaerialrobotics@gmail.com">washingtonaerialrobotics@gmail.com</a>
    </div>
    <div class="col">
      <h4 class="mono">Explore</h4>
      <a href="/about">About</a>
      <a href="/drones">Drones</a>
      <a href="/team">Team</a>
      <a href="/updates">Updates</a>
    </div>
    <div class="col">
      <h4 class="mono">Get involved</h4>
      <a href="/join">Join the team</a>
      <a href="/faq">FAQ</a>
      <a href="mailto:washingtonaerialrobotics@gmail.com">Contact</a>
    </div>
  </div>
  <div class="foot-bottom">
    <span class="mono">© {year} WAAR · University of Washington</span>
    <span class="mono">IARC · Autonomous aerial robotics</span>
  </div>
</footer>

<style>
  .foot{border-top:1px solid var(--line-soft);background:var(--bg-2);position:relative;z-index:4}
  .foot-inner{max-width:var(--maxw);margin:0 auto;padding:clamp(50px,8vh,84px) var(--pad) 40px;
    display:grid;grid-template-columns:2fr 1fr 1fr;gap:40px}
  .fbrand{font-family:"Chakra Petch",sans-serif;font-weight:600;text-transform:uppercase;letter-spacing:.04em;font-size:16px}
  .mark{color:var(--purple)}
  .tagline{color:var(--muted);font-size:14px;margin:14px 0 18px;max-width:38ch;line-height:1.6}
  .email{font-size:12.5px;color:var(--gold);text-decoration:none}
  .email:hover{text-decoration:underline}
  .col h4{font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);margin-bottom:16px;font-weight:500}
  .col a{display:block;color:var(--text);text-decoration:none;font-size:14px;padding:6px 0;opacity:.85;transition:opacity .2s,color .2s}
  .col a:hover{opacity:1;color:var(--purple)}
  .foot-bottom{max-width:var(--maxw);margin:0 auto;padding:22px var(--pad);border-top:1px solid var(--line-soft);
    display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;color:var(--muted);font-size:11px;letter-spacing:.06em}
  @media (max-width:820px){.foot-inner{grid-template-columns:1fr 1fr}.brandcol{grid-column:1/-1}}
</style>
