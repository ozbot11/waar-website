---
interface Props {
  name: string;
  role: string;
  photo?: string;
  initials?: string;
  lines?: string[];
  delay?: string;
  class?: string;
}
const { name, role, photo, initials = '•', lines = [], delay, class: className } = Astro.props;
---
<figure class:list={['member', 'reveal', className]} data-delay={delay}>
  <button class="flip" type="button" aria-expanded="false" aria-label={`Flip card for ${name}`}>
    <span class="flip-inner">
      <span class="photo flip-face flip-front">
        {photo
          ? <img src={photo} alt="" width="560" height="700" loading="lazy" />
          : <span class="photo-ph" aria-hidden="true">{initials}</span>}
        <span class="flip-hint mono">Click to flip</span>
      </span>
      <span class="photo flip-face flip-back">
        <span class="flip-body">
          <span class="flip-k mono">{role}</span>
          {lines.length > 0
            ? <ul>{lines.map((line) => <li>{line}</li>)}</ul>
            : <p>Focus areas and a short bio will live here.</p>}
        </span>
      </span>
    </span>
  </button>
  <figcaption>
    <div class="name">{name}</div>
    <div class="role mono">{role}</div>
  </figcaption>
</figure>

<style>
  .member{margin:0;width:min(100%,300px);flex:0 0 auto}
  .name{font-family:"Chakra Petch",sans-serif;font-weight:600;font-size:19px;letter-spacing:.01em}
  .role{font-size:11px;letter-spacing:.14em;color:var(--gold);margin-top:8px;text-transform:uppercase}
  figcaption{padding-top:16px}

  .flip{display:block;width:100%;padding:0;border:0;background:none;cursor:pointer;
    perspective:1000px;border-radius:12px}
  .flip-inner{display:block;position:relative;aspect-ratio:4/5;transform-style:preserve-3d;
    transition:transform .55s cubic-bezier(.2,.7,.2,1)}
  .flip.is-flipped .flip-inner{transform:rotateY(180deg)}
  .photo{position:absolute;inset:0;border-radius:12px;overflow:hidden;
    border:1px solid var(--line-soft);background:var(--bg-2);backface-visibility:hidden;
    -webkit-backface-visibility:hidden}
  .photo img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .45s,filter .35s}
  .flip-back{transform:rotateY(180deg);display:flex;align-items:center;
    background:linear-gradient(180deg,#1a1230 0%,#120c1f 100%);padding:22px 18px}
  .flip-body{text-align:left}
  .flip-k{display:block;font-size:10px;letter-spacing:.16em;color:var(--gold);text-transform:uppercase;margin-bottom:12px}
  .flip-body ul{margin:0;padding:0;list-style:none;display:grid;gap:8px}
  .flip-body li,.flip-body p{color:#C6BFD8;font-size:13.5px;line-height:1.4}
  .flip-hint{position:absolute;inset:0;display:flex;align-items:flex-end;justify-content:center;
    padding:16px;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:#ECE8F6;
    background:linear-gradient(180deg,rgba(74,46,131,.15),rgba(28,16,52,.72));
    opacity:0;transition:opacity .3s}
  .flip:hover:not(.is-flipped) .flip-hint{opacity:1}
  .flip:hover:not(.is-flipped) .photo{border-color:var(--purple);box-shadow:0 18px 44px rgba(0,0,0,.45)}
  .flip:hover:not(.is-flipped) img{transform:scale(1.04);filter:grayscale(.2) saturate(1.2)}
  .flip:focus-visible{outline:2px solid var(--purple);outline-offset:3px}
  .photo-ph{width:100%;height:100%;display:flex;align-items:center;justify-content:center;
    font-family:"Chakra Petch",sans-serif;font-size:48px;letter-spacing:.08em;color:var(--purple);background:var(--bg-2)}
</style>
