---
import Base from '../layouts/Base.astro';
---
<Base title="About · Washington Aerial Robotics">
  <section class="page-head">
    <div class="container">
      <p class="eyebrow reveal">About the team</p>
      <h1 class="reveal" data-delay="1">Students building <span class="accent">autonomous flight</span></h1>
    </div>
  </section>

  <!-- who we are -->
  <section class="section">
    <div class="container narrow">
      <p class="lead reveal">
        Washington Aerial Robotics is a multidisciplinary engineering team of students and faculty at the
        University of Washington in Seattle. We design, manufacture, and test autonomous drones &mdash; with a
        main focus on quadcopters &mdash; giving members hands-on experience across software development, systems
        engineering, 3D modeling, hardware manufacturing, guidance, navigation &amp; control, and pilot operation.
      </p>
      <p class="body reveal" data-delay="1">
        Our purpose is simple: give the UW engineering community real opportunities to learn how autonomous
        aerial systems are built &mdash; not in theory, but by putting drones in the air.
      </p>
    </div>
  </section>

  <!-- IARC -->
  <section class="section iarc">
    <div class="container">
      <div class="split iarc-split">
        <div class="emblem reveal">
          <img src="/about/iarc-logo.png" alt="International Aerial Robotics Competition logo" />
        </div>
        <div class="reveal" data-delay="1">
          <p class="eyebrow gold">The competition</p>
          <h2 style="margin-top:18px">The International <em>Aerial Robotics</em> Competition</h2>
          <p class="body">
            Washington Aerial Robotics participates in the International Aerial Robotics Competition (IARC),
            one of the most long-running and technically challenging autonomous aerial robotics contests in
            the world. It is specifically designed to push the limits of what autonomous flying robots can do.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission 10 -->
  <section class="section mission10">
    <div class="container">
      <div class="split m10-split">
        <div class="reveal">
          <p class="eyebrow">Current challenge</p>
          <h2 style="margin-top:18px">Mission <em>10</em></h2>
          <p class="body">
            Mission 10 of the IARC focuses on a team of four autonomous drones working together to map a
            simulated minefield and determine the safest and most efficient path through it. Instead of just
            detecting mines, the mission emphasizes real-time coordination, communication, and decision-making
            as a swarm.
          </p>
          <p class="body">
            The drones must share data, build a map of the environment, avoid obstacles, and quickly identify
            an optimal route a person could safely follow &mdash; all without human control. Scoring is based on
            how safe and efficient the chosen path is, how quickly the solution is generated, and how well the
            system avoids errors such as missed hazards.
          </p>
        </div>
        <figure class="shot reveal" data-delay="1">
          <span class="br tl"></span><span class="br tr"></span><span class="br bl"></span><span class="br br"></span>
          <img src="/about/mission10.jpg" alt="Four autonomous drones mapping a simulated minefield and relaying a safe path to a person walking on the ground" />
          <figcaption class="mono">IARC MISSION 10 &middot; SWARM MINEFIELD MAPPING</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- how we're organized -->
  <section class="section">
    <div class="container">
      <p class="eyebrow reveal">How we are organized</p>
      <div class="grid grid-2" style="margin-top:34px">
        <div class="cell reveal">
          <div class="num">SUBTEAM 01</div>
          <h3 style="margin:14px 0 16px">Hardware</h3>
          <p class="cell-p">CAD design, drone avionics, prototyping, manufacturing, PCB design, and embedded
            electronics &mdash; the physical aircraft and the systems that power it.</p>
        </div>
        <div class="cell reveal" data-delay="1">
          <div class="num">SUBTEAM 02</div>
          <h3 style="margin:14px 0 16px">Software</h3>
          <p class="cell-p">ROS (C++ / Python), PX4 and Bitcraze flight software, computer vision, path
            planning, and SLAM &mdash; the autonomy that lets the drone fly itself.</p>
        </div>
      </div>
      <div class="reveal" style="margin-top:56px">
        <a class="btn primary" href="/join">Join the team</a>
        <a class="btn" href="/drones" style="margin-left:10px">See what we build</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .narrow{max-width:820px}
  .body{font-size:16px;line-height:1.7;color:#C6BFD8;margin-top:22px;max-width:64ch}
  .cell-p{font-size:14.5px;line-height:1.6;color:var(--muted);max-width:44ch}
  .split{display:grid;grid-template-columns:1fr 1.2fr;gap:clamp(30px,6vw,80px);align-items:center}

  .iarc{background:linear-gradient(180deg,var(--bg) 0%,#0E0A18 100%);border-block:1px solid var(--line-soft)}
  .iarc-split{grid-template-columns:0.85fr 1.15fr}
  .emblem{position:relative;display:flex;justify-content:center}
  .emblem::before{content:"";position:absolute;inset:6% 12%;border-radius:50%;
    background:radial-gradient(circle,rgba(157,123,255,.30),transparent 62%);filter:blur(14px);z-index:0}
  .emblem img{position:relative;z-index:1;width:min(320px,80%);height:auto;
    filter:drop-shadow(0 12px 30px rgba(0,0,0,.5))}

  /* Mission 10 image in a HUD frame */
  .m10-split{grid-template-columns:1.15fr 0.85fr}
  .shot{position:relative;margin:0}
  .shot img{width:100%;height:auto;display:block;border-radius:10px;
    border:1px solid var(--line-soft);box-shadow:0 24px 60px rgba(0,0,0,.5)}
  .shot figcaption{margin-top:12px;font-size:10.5px;letter-spacing:.22em;color:var(--muted);text-align:right}
  .shot .br{position:absolute;width:20px;height:20px;border:1.5px solid var(--gold);opacity:.7;z-index:2}
  .shot .br.tl{top:-6px;left:-6px;border-right:0;border-bottom:0}
  .shot .br.tr{top:-6px;right:-6px;border-left:0;border-bottom:0}
  .shot .br.bl{bottom:34px;left:-6px;border-right:0;border-top:0}
  .shot .br.br{bottom:34px;right:-6px;border-left:0;border-top:0}

  @media (max-width:820px){
    .split{grid-template-columns:1fr!important;gap:40px}
    .emblem img{width:min(240px,60%)}
    .m10-split{display:flex;flex-direction:column-reverse}
  }
</style>
