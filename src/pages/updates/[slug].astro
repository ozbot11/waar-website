---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('updates', ({ data }) => !data.draft);
  return posts.map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title={`${post.data.title} · WAAR`} description={post.data.summary}>
  <article class="post-page">
    <div class="container narrow">
      <a class="back mono" href="/updates">← All updates</a>
      <div class="meta">
        <span class="tag mono">{post.data.tag}</span>
        <time class="mono">{fmt(post.data.date)}</time>
      </div>
      <h1>{post.data.title}</h1>
      <p class="summary">{post.data.summary}</p>
      {post.data.hero && (
        <figure class="hero-shot">
          <img src={post.data.hero} alt={post.data.heroAlt || post.data.title} />
        </figure>
      )}
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</Base>

<style>
  .post-page{padding:clamp(120px,18vh,200px) 0 clamp(60px,10vh,120px)}
  .narrow{max-width:760px}
  .back{display:inline-block;color:var(--muted);text-decoration:none;font-size:12px;letter-spacing:.1em;margin-bottom:40px}
  .back:hover{color:var(--purple)}
  .meta{display:flex;gap:16px;align-items:center;margin-bottom:18px}
  .meta .tag{color:var(--gold);font-size:10.5px;letter-spacing:.16em;text-transform:uppercase}
  .meta time{color:var(--muted);font-size:12px}
  h1{font-size:clamp(32px,5.5vw,60px);font-weight:700;line-height:1}
  .summary{color:#C6BFD8;font-size:18px;line-height:1.6;margin:22px 0 40px}
  .hero-shot{margin:0 0 44px}
  .hero-shot img{width:100%;height:auto;display:block;border-radius:12px;border:1px solid var(--line-soft)}
  .prose{font-size:16px;line-height:1.8;color:#C6BFD8}
  .prose :global(p){margin:0 0 20px}
  .prose :global(h2){font-size:26px;margin:40px 0 16px}
  .prose :global(blockquote){border-left:2px solid var(--gold);padding-left:20px;color:var(--muted);
    font-style:italic;margin:24px 0}
  .prose :global(a){color:var(--purple)}
  .prose :global(strong){color:var(--text)}
</style>
