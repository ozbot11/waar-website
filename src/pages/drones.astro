---
import Base from '../layouts/Base.astro';
import DroneViewer from '../components/DroneViewer.astro';
---
<Base title="Drones · Washington Aerial Robotics">
  <section class="page-head">
    <div class="container">
      <p class="eyebrow reveal">The fleet</p>
      <h1 class="reveal" data-delay="1">Our <span class="accent">airframes</span></h1>
      <p class="lead reveal" data-delay="2" style="margin-top:24px">
        Every drone we fly is designed, built, and programmed in-house. Drag the model below to inspect
        the current competition airframe.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="reveal"><DroneViewer /></div>

      <div class="specs">
        <div class="spec reveal"><span class="mono k">CONFIG</span><span class="v">Quadcopter · X-frame</span></div>
        <div class="spec reveal" data-delay="1"><span class="mono k">AUTONOMY</span><span class="v">GPS-denied capable</span></div>
        <div class="spec reveal" data-delay="2"><span class="mono k">PERCEPTION</span><span class="v">Onboard vision + SLAM</span></div>
        <div class="spec reveal" data-delay="3"><span class="mono k">STACK</span><span class="v">ROS · PX4 / Bitcraze</span></div>
      </div>
    </div>
  </section>

  <section class="section subsystems">
    <div class="container">
      <p class="eyebrow gold reveal">Under the hood</p>
      <div class="grid grid-3" style="margin-top:34px">
        <div class="cell reveal">
          <h3>Airframe</h3>
          <p class="p">Custom frame geometry, motor mounts, and landing gear — modeled in CAD, prototyped, and manufactured by the Hardware subteam.</p>
        </div>
        <div class="cell reveal" data-delay="1">
          <h3>Avionics</h3>
          <p class="p">Flight controller, power distribution, and a sensor suite wired through custom PCBs and embedded firmware.</p>
        </div>
        <div class="cell reveal" data-delay="2">
          <h3>Autonomy</h3>
          <p class="p">Perception, localization, and path planning running in ROS — the software that turns a drone into an autonomous one.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow reveal">Build history</p>
      <div class="builds" style="margin-top:34px">
        <article class="build reveal">
          <div class="tag mono">CURRENT</div>
          <h3>WAAR-01</h3>
          <p class="p">The current competition airframe — designed in CAD by the Hardware subteam.</p>
        </article>
        <article class="build reveal" data-delay="1">
          <div class="tag mono">ARCHIVE</div>
          <h3>Prototype</h3>
          <p class="p">Placeholder for an earlier build. Document what you learned and what changed.</p>
        </article>
      </div>
    </div>
  </section>
</Base>

<style>
  .specs{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line-soft);
    border:1px solid var(--line-soft);border-top:0;margin-top:0}
  .spec{background:var(--bg-2);padding:22px 24px;display:flex;flex-direction:column;gap:8px}
  .spec .k{font-size:10.5px;letter-spacing:.18em;color:var(--muted)}
  .spec .v{font-size:14.5px;color:var(--text)}
  .subsystems{background:linear-gradient(180deg,var(--bg) 0%,#0E0A18 100%);border-block:1px solid var(--line-soft)}
  .p{font-size:14.5px;line-height:1.6;color:var(--muted);margin-top:14px;max-width:40ch}
  .builds{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--line-soft);border:1px solid var(--line-soft)}
  .build{background:var(--bg-2);padding:clamp(26px,3vw,42px)}
  .build .tag{font-size:10.5px;letter-spacing:.2em;color:var(--gold);margin-bottom:14px}
  .build h3{margin-bottom:6px}
  @media (max-width:820px){.specs{grid-template-columns:repeat(2,1fr)}.builds{grid-template-columns:1fr}}
</style>
